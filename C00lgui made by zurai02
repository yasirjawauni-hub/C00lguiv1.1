	if State.spinOn then
		local hrp = getHRP()
		if not hrp then return NotifyERR("No HRP!") end
		State.lockBP = Instance.new("BodyPosition")
		State.lockBP.Position = hrp.Position
		State.lockBP.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		State.lockBP.P = 1e5
		State.lockBP.Parent = hrp
		State.spinBAV = Instance.new("BodyAngularVelocity")
		State.spinBAV.AngularVelocity = Vector3.new(0, 10000, 0)
		State.spinBAV.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
		State.spinBAV.P = 1e5
		State.spinBAV.Parent = hrp
		Notify("Spin Bot ON", "SYSTEM", 2)
	else
		if State.spinBAV then State.spinBAV:Destroy(); State.spinBAV = nil end
		if State.lockBP then State.lockBP:Destroy(); State.lockBP = nil end
		Notify("Spin Bot OFF", "SYSTEM", 2)
	end
end, "Visual", "Spin")

FunctionManager:register("Save Position", function()
	local hrp = getHRP()
	if hrp then
		State.savedCFrame = hrp.CFrame
		Notify("Position Saved", "SYSTEM", 2)
	end
end, "Utility", "Checkpoint")

FunctionManager:register("Load Position", function()
	local hrp = getHRP()
	if State.savedCFrame and hrp then
		hrp.CFrame = State.savedCFrame
		Notify("Position Loaded", "SYSTEM", 2)
	else
		NotifyERR("No saved position")
	end
end, "Utility", "Reload")

FunctionManager:register("No-Clip", function()
	State.noclipOn = not State.noclipOn
	if State.noclipOn then
		local hrp = getHRP()
		if not hrp then return NotifyERR("No HRP!") end
		State.hoverHeight = hrp.Position.Y
		addConn("noclip", RunService.Stepped:Connect(function()
			local char = getChar()
			if not char then return end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
			local h = getHRP()
			if h then
				local p = h.Position
				h.CFrame = CFrame.new(p.X, State.hoverHeight, p.Z)
			end
		end))
		Notify("No-Clip ON", "SYSTEM", 2)
	else
		removeConn("noclip")
		local char = getChar()
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
		Notify("No-Clip OFF", "SYSTEM", 2)
	end
end, "Movement", "NOCLIP")

FunctionManager:register("Fly", function()
	State.flyOn = not State.flyOn
	if State.flyOn then
		local hrp = getHRP()
		if not hrp then return NotifyERR("No HRP!") end
		State.flyBG = Instance.new("BodyGyro")
		State.flyBG.P = 9e4
		State.flyBG.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
		State.flyBG.CFrame = hrp.CFrame
		State.flyBG.Parent = hrp
		State.flyBV = Instance.new("BodyVelocity")
		State.flyBV.MaxForce = Vector3.new(9e4, 9e4, 9e4)
		State.flyBV.Velocity = Vector3.new(0, 0, 0)
		State.flyBV.Parent = hrp
		addConn("fly", RunService.Heartbeat:Connect(function()
			local h = getHRP()
			if not h then return end
			local cam = workspace.CurrentCamera.CFrame
			local dir = Vector3.new()
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
			if dir.Magnitude > 0 then dir = dir.Unit * 50 end
			State.flyBV.Velocity = dir
			State.flyBG.CFrame = CFrame.new(h.Position, h.Position + cam.LookVector)
		end))
		Notify("Fly ON", "SYSTEM", 2)
	else
		removeConn("fly")
		if State.flyBG then State.flyBG:Destroy(); State.flyBG = nil end
		if State.flyBV then State.flyBV:Destroy(); State.flyBV = nil end
		Notify("Fly OFF", "SYSTEM", 2)
	end
end, "Movement", "Fly!")

